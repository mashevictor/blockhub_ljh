{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["../shared/*"],
      "@blockhub/i18n": ["../packages/i18n/src/index.d.ts"],
      "@blockhub/i18n/react": ["../packages/i18n/src/react.d.ts"],
      "@blockhub/web-core": ["./src/web-core-shim.d.ts"],
      "@blockhub/web-capability-*": ["../packages/web-capability-*/src/index.ts"],
      "@capship/composer": ["../packages/capship-composer/src/index.d.ts"],
      "@capship/composer/styles.css": ["./src/vite-env.d.ts"]
    }
  },
  "include": ["src"]
}
