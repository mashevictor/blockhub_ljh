# 腾讯云 PostgreSQL 迁移示例
# 复制关键项到 backend/.env 后执行: bash scripts/migrate-tencentdb.sh
#
# DATABASE_URL=postgresql+psycopg2://trackchat:YOUR_PASSWORD@pg-xxxxx.tencentcdb.com:5432/trackchat?sslmode=require
# REDIS_URL=redis://127.0.0.1:6379/0
# PUBLIC_BASE_URL=https://your-domain.com
# JWT_SECRET=replace-with-32chars-random-string
