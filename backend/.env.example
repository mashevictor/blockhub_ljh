# DeepSeek（模块推荐 / 能力补全，可选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Chat LLM（OpenAI 兼容：DeepSeek / 通义 / 豆包；未设则回退 DEEPSEEK_*，再无则 Mock）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=60

# 截图/视觉理解（OpenAI 兼容多模态；CapShip 对话改页粘贴截图）。未设则回退 LLM_*。
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_TIMEOUT=90

# WaveSpeed.ai 截图识别（优先）。默认 flash 保交互速度；要更准再改 pro
WAVESPEED_API_KEY=
WAVESPEED_VISION_MODEL=google/gemini-2.5-flash
WAVESPEED_TIMEOUT=45

# TinyPNG 截图压缩（识别前）。https://tinypng.com/developers
TINYPNG_API_KEY=

# PostgreSQL（必填，不支持 SQLite）
# 本地: postgresql+psycopg2://trackchat:trackchat@127.0.0.1:5432/trackchat
# 腾讯云: postgresql+psycopg2://user:pass@xxx.tencentcdb.com:5432/trackchat?sslmode=require
DATABASE_URL=postgresql+psycopg2://trackchat:trackchat@127.0.0.1:5432/trackchat

# JWT（生产务必修改 JWT_SECRET 为 32 位以上随机字符串）
JWT_SECRET=change-me-in-production-trackchat-d1
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS（逗号分隔，含 Home 与 Admin 访问地址）
CORS_ORIGINS=https://blockhub.club,https://www.blockhub.club,http://blockhub.club,http://www.blockhub.club,http://101.32.209.251,http://101.32.209.251/admin,http://localhost:5173,http://localhost:5174

# 公网访问地址（应用链接、二维码、下载地址）
PUBLIC_BASE_URL=https://blockhub.club

# 验证码演示模式（生产务必 false；true 时 API 可能返回 debug_code，前端已不展示）
OTP_DEBUG_EXPOSE=false

# --- 生产上线前检查（GA 后）---
# 1. JWT_SECRET 改为 32 位以上随机串
# 2. OTP_DEBUG_EXPOSE=false
# 3. 腾讯云 PG: DATABASE_URL 加 ?sslmode=require
# 4. 跑: bash blockhub.sh secrets-check
# 5. 配置 cron: bash blockhub.sh pg-backup

# Redis（D5 限流 / 缓存）
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_ENABLED=true

# 腾讯云 COS（生产文件存储；留空则使用本地 uploads/）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_CDN_BASE_URL=

# 邮件（QQ 邮箱 SMTP — 使用授权码，勿提交真实密码到 Git）
SMTP_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=积木仓 BlockHub
# 默认 false：附带 .apk 极易被 Gmail/企业邮退信
SMTP_ATTACH_APK=false
PUBLISH_EMAIL_ENABLED=true
PUBLISH_EMAIL_ENABLED=true

# 电信星辰 MaaS · 上海话语音 Agent（密钥勿提交 Git）
TELEAI_APP_ID=
TELEAI_APP_KEY=
TELEAI_REGION=SH
TELEAI_HOST=openapi.teleagi.cn
TELEAI_ASR_PATH=/aipaas/voice/v1/asr/fy
TELEAI_TTS_PATH=/aipaas/voice/v1/tts/supernaturalrt
TELEAI_TTS_DIALECT=shanghai
TELEAI_AUTH_EXPIRE_SECONDS=180000

# 知识库 Embedding（OpenAI 兼容；通义 text-embedding-v3 / 豆包等）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1536
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=80

# 企业微信 SSO（P4-I2；未配置时 /auth/oauth/wecom/start 返回 503）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 可选，默认 {PUBLIC_BASE_URL}/api/v1/auth/oauth/wecom/callback
WECOM_OAUTH_REDIRECT_URI=

# 易宝 · 聚合收款（官网升级套餐；未配置时 POST /billing/checkout → 503）
YEEPAY_MERCHANT_NO=
YEEPAY_PARENT_MERCHANT_NO=
YEEPAY_APP_KEY=
YEEPAY_API_BASE=https://openapi.yeepay.com/yop-center
YEEPAY_CREATE_PATH=/rest/v1.0/aggpay/pay-link
# 空则 {PUBLIC_BASE_URL}/api/v1/billing/webhook/yeepay
YEEPAY_NOTIFY_URL=
# 空则 {PUBLIC_BASE_URL}/pricing/result
YEEPAY_RETURN_URL=
# PEM 内容或私钥文件路径（可选）
YEEPAY_PRIVATE_KEY_PEM=

# IM 群机器人解耦自动化（设了即自动绑 connector，报修/审批免手填 Runtime）
# IM_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=…
IM_WECOM_WEBHOOK_URL=
IM_DINGTALK_WEBHOOK_URL=
IM_FEISHU_WEBHOOK_URL=
# demo | 多 slug 逗号分隔 | * = 全部租户
IM_AUTO_TENANT_SLUGS=demo
