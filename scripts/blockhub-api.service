[Unit]
Description=BlockHub FastAPI API
After=network.target postgresql.service

[Service]
User=root
WorkingDirectory=BLOCKHUB_ROOT/backend
EnvironmentFile=BLOCKHUB_ROOT/backend/.env
Environment=PATH=BLOCKHUB_ROOT/backend/.venv/bin
ExecStart=BLOCKHUB_ROOT/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
