[Unit]
Description=BlockHub FastAPI API
After=network.target postgresql.service

[Service]
User=root
WorkingDirectory=/root/blockhub/backend
EnvironmentFile=/root/blockhub/backend/.env
Environment=PATH=/root/blockhub/backend/.venv/bin
ExecStart=/root/blockhub/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
