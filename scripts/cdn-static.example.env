# 可选：静态配图走 CDN（腾讯云 COS / 阿里云 OSS / Cloudflare R2）
# 1) 把 home/public/industry 与 home/public/news 同步到桶，公网前缀如下
# 2) 构建 home 前导出该变量，或写入 home/.env.production
# 3) Nginx 源站仍保留文件，CDN 回源或定期 rsync 均可

VITE_STATIC_CDN_BASE=https://cdn.blockhub.club

# 同步示例（COS）：
# coscli sync home/public/industry/ cos://your-bucket/industry/ -r
# coscli sync home/public/news/ cos://your-bucket/news/ -r
#
# Cloudflare：灰云代理 blockhub.club 即可边缘缓存（需上面 Nginx Cache-Control 生效）
