{
  "overview": "为销售团队提供从线索到回款的全流程数字化支撑，提升客户转化与业绩管理效率。",
  "highlights": [
    "统一管理客户跟进与商机阶段",
    "快速报价、合同审批与折扣控制",
    "实时销售漏斗与业绩排行看板",
    "集成CRM、IM与费用申请，打通业务闭环"
  ],
  "scenes": [
    {
      "name": "产品/话术问答",
      "category": "销售赋能",
      "capability_key": "chat_qa",
      "pages": "知识问答",
      "problem": "销售无法快速获取产品参数或标准话术，影响客户沟通效率。",
      "page_kind": "chat_kb",
      "default_category": "话术库",
      "form_headline": "话术问答",
      "fields": [
        {
          "key": "question",
          "label": "问题",
          "type": "text",
          "placeholder": "例如：产品A的定价策略",
          "optional": false
        },
        {
          "key": "answer",
          "label": "答案",
          "type": "textarea",
          "placeholder": "输入标准话术或产品说明",
          "optional": false
        }
      ]
    },
    {
      "name": "报价/折扣审批",
      "category": "销售流程",
      "capability_key": "quote_contract",
      "pages": "报价审批",
      "problem": "销售报价或折扣超出权限时，需要快速提交审批，避免丢单。",
      "page_kind": "form_list",
      "default_category": "报价审批",
      "form_headline": "报价/折扣审批",
      "fields": [
        {
          "key": "customer",
          "label": "客户名称",
          "type": "text",
          "placeholder": "输入客户名称",
          "optional": false
        },
        {
          "key": "amount",
          "label": "报价金额",
          "type": "number",
          "placeholder": "输入金额",
          "optional": false
        },
        {
          "key": "discount",
          "label": "折扣比例",
          "type": "number",
          "placeholder": "例如：10",
          "optional": true
        },
        {
          "key": "reason",
          "label": "折扣原因",
          "type": "textarea",
          "placeholder": "说明折扣理由",
          "optional": false
        }
      ]
    },
    {
      "name": "销售漏斗看板",
