{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"],
      "@blockhub/i18n": ["../packages/i18n/src/index.d.ts"],
      "@blockhub/i18n/react": ["../packages/i18n/src/react.d.ts"],
      "@blockhub/web-core": ["../packages/web-core/src/developer-panel.d.ts"],
      "@blockhub/web-core/gtgt": ["./src/types/web-core-gtgt.d.ts"],
      "@blockhub/web-core/resolveFormSteps": ["./src/types/web-core-resolveFormSteps.d.ts"],
      "@capship/composer": ["./node_modules/@capship/composer/src/index.d.ts"],
      "@capship/composer/styles.css": ["./src/types/css-modules.d.ts"]
    }
  },
  "include": ["src", "../shared"]
}
